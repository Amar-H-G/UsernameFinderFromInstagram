<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8" />
    <title>Result — Username</title>
    <style>
      body {
        font-family: Arial, sans-serif;
        padding: 30px;
        max-width: 700px;
        margin: auto;
      }
      a.button {
        display: inline-block;
        padding: 8px 12px;
        background: #007bff;
        color: white;
        border-radius: 6px;
        text-decoration: none;
      }
      .info {
        margin-top: 20px;
        padding: 12px;
        border: 1px solid #ddd;
        border-radius: 6px;
        background: #fafafa;
      }
    </style>
  </head>
  <body>
    <h1>Username Found</h1>
    <div class="info">
      <p>
        <strong>Reel URL:</strong>
        <a href="<%= url %>" target="_blank" rel="noopener noreferrer"
          ><%= url %></a
        >
      </p>
      <p><strong>Username:</strong> @<%= username %></p>
      <p>
        You can open the profile:
        <a href="https://www.instagram.com/<%= username %>/" target="_blank"
          >@<%= username %> profile</a
        >
      </p>
    </div>

    <p style="margin-top: 18px">
      <a class="button" href="/">Check another</a>
    </p>
  </body>
</html>
