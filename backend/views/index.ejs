<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8" />
    <title>Instagram Reel → Username</title>
    <link rel="stylesheet" href="/style.css" />
    <style>
      body {
        font-family: Arial, sans-serif;
        padding: 30px;
        max-width: 700px;
        margin: auto;
      }
      input[type="text"] {
        width: 80%;
        padding: 8px;
        font-size: 16px;
      }
      button {
        padding: 8px 12px;
        font-size: 16px;
      }
      .error {
        color: #b00020;
        margin-top: 12px;
      }
      .hint {
        color: #555;
        margin-top: 8px;
      }
    </style>
  </head>
  <body>
    <h1>Instagram Reel → Username</h1>
    <form action="/extract" method="post">
      <label for="url">Paste public Instagram Reels URL:</label><br /><br />
      <input
        id="url"
        name="url"
        type="text"
        placeholder="https://www.instagram.com/reel/SHORTCODE/"
        value="<%= url ? url : '' %>"
      />
      <button type="submit">Submit</button>
    </form>

    <% if (error) { %>
    <div class="error"><strong>Error:</strong> <%= error %></div>
    <% } %>

    <p class="hint">
      Tip: This works best for public reels. Private posts or heavy JS-rendered
      pages may not return username.
    </p>
  </body>
</html>
